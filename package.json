{
  "name": "harness-engineering",
  "version": "0.1.0",
  "description": "Un harness de agente de código construido desde cero para aprender cómo funcionan por dentro.",
  "type": "module",
  "bin": {
    "harness": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "ui": "npm run build && node dist/server/server.js",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
