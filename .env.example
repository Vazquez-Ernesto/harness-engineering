# Copia este archivo a .env en la raíz del repo y pon tus claves.
# .env está en .gitignore: NUNCA lo subas a GitHub.
# Solo necesitas UNA de estas claves para empezar.

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai/keys) - tiene modelos gratis terminados en ":free"
OPENROUTER_API_KEY=

# Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=
# Ollama local, sin clave: descomenta esto y comenta OLLAMA_API_KEY
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Anthropic / Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ── Opcionales ──
# HARNESS_PROVIDER=gemini     # anthropic | gemini | openrouter | ollama (por defecto: el primero con clave)
# HARNESS_MODEL=gemini-2.5-flash
# HARNESS_EFFORT=high         # solo Anthropic: low | medium | high | xhigh | max
# HARNESS_MAX_STEPS=50
# HARNESS_PORT=4317           # puerto de la UI web
